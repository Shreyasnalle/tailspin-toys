---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const database = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(database),
  getAllCategories(database),
  getAllPublishers(database),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-400" data-testid="filter-results" aria-live="polite">
          Showing {games.length} {games.length === 1 ? 'game' : 'games'}
        </p>
      </div>

      {games.length > 0 && (
        <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5" data-testid="game-filters">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end">
            <fieldset class="flex-1">
              <legend class="mb-3 text-sm font-semibold text-slate-200">Filter by category</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-300 transition-colors hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="size-4 accent-blue-500"
                      data-testid={`category-filter-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="min-w-56">
              <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">Filter by publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>

            <button
              type="reset"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </div>
        </form>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      {games.length > 0 && (
        <div class="hidden" data-testid="no-filter-results">
          <EmptyState text="No games match the selected filters." />
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const results = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  if (filterForm && results && noResults) {
    const applyFilters = (): void => {
      const selectedCategories = new Set(
        [...filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')].map(
          (input) => input.value,
        ),
      );
      const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryMatches =
          selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || selectedPublisher === (card.dataset.publisherId ?? '');
        const visible = categoryMatches && publisherMatches;
        card.classList.toggle('hidden', !visible);
        visibleCount += visible ? 1 : 0;
      });

      results.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
      noResults.classList.toggle('hidden', visibleCount !== 0);
    };

    filterForm.addEventListener('change', applyFilters);
    filterForm.addEventListener('reset', () => requestAnimationFrame(applyFilters));
  }
</script>
